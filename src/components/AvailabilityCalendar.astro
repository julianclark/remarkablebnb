---
import { buildMonths, type DateRange } from '../lib/availability';
import { getSiteFacts } from '../lib/site-facts';

interface Props {
  bookedRanges: DateRange[];
  staySlug: string;
  stayType: string;
  maxGuests: number;
  airbnbUrl: string;
  monthsToShow?: number;
}

// Availability only. We publish no nightly rate here: Airbnb's figure varies
// with extra-guest fees, so a mirrored number would be wrong for larger
// parties. Instead the guest picks dates and party size here, and both the
// enquiry link and the Airbnb link carry that through, so the price Airbnb
// shows them is the price for their actual party.
const { bookedRanges, staySlug, stayType, maxGuests, airbnbUrl, monthsToShow = 12 } = Astro.props;

const { directDiscountPercent: discountPercent } = await getSiteFacts();

const months = buildMonths(monthsToShow, bookedRanges, new Date());
const weekdayLabels = ['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su'];

function longDate(iso: string): string {
  return new Date(iso + 'T00:00:00Z').toLocaleDateString('en-NZ', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
}

// No-JS fallback: each available day links to the contact form pre-filled
// with that date. JS enhances this into check-in/check-out range selection.
function enquireHref(date: string): string {
  return `/contact?stay=${encodeURIComponent(stayType)}&date=${date}`;
}
---

<div
  class="availability"
  data-availability
  data-stay-type={stayType}
  data-stay-slug={staySlug}
  data-max-guests={maxGuests}
  data-airbnb-url={airbnbUrl}
>
  <p class="text-sm text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] mb-4" data-hint>
    Green dates are open. Tap a date to enquire, or tap a check-in then a check-out date for a range.
  </p>

  <!-- Party size. Airbnb prices extra guests, so this travels with both the
       enquiry and the Airbnb link rather than being asked for later. -->
  <fieldset class="cal-guests">
    <legend class="cal-guests-legend">How many guests?</legend>
    <div class="cal-guests-fields">
      <label class="cal-guest-field">
        <span>Adults</span>
        <input type="number" inputmode="numeric" min="1" max={maxGuests} step="1" value="2" data-guests-adults />
      </label>
      <label class="cal-guest-field">
        <span>Children</span>
        <input type="number" inputmode="numeric" min="0" max={maxGuests - 1} step="1" value="0" data-guests-children />
      </label>
    </div>
    <p class="cal-guests-note" data-guests-note aria-live="polite">
      This stay sleeps up to {maxGuests}.
    </p>
  </fieldset>

  <!-- Pager (revealed by JS; without JS all months stack and remain browsable) -->
  <div class="cal-pager" data-pager hidden>
    <button type="button" class="cal-pager-btn" data-page-prev aria-label="Earlier months">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5"/></svg>
    </button>
    <span class="cal-pager-label" data-page-label aria-live="polite"></span>
    <button type="button" class="cal-pager-btn" data-page-next aria-label="Later months">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
    </button>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6" data-months>
    {months.map((month, mi) => (
      <div class="rounded-xl border border-[var(--color-hairline)] dark:border-[var(--color-stone-grey)] p-4 cal-month" data-month-index={mi} data-month-label={month.label}>
        <div class="text-sm font-semibold mb-3 text-center">{month.label}</div>
        <div class="grid grid-cols-7 gap-1 text-xs text-center text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] mb-1">
          {weekdayLabels.map((w) => <div aria-hidden="true">{w}</div>)}
        </div>
        <div class="grid grid-cols-7 gap-1">
          {month.weeks.flatMap((week) =>
            week.map((day) => {
              if (!day.inMonth) return <div />;
              if (day.isPast) {
                return (
                  <div class="cal-day cal-past" aria-hidden="true">{day.day}</div>
                );
              }
              if (day.booked) {
                return (
                  <div class="cal-day cal-booked" aria-label={`${longDate(day.date)}, booked`}>
                    <span>{day.day}</span>
                  </div>
                );
              }
              return (
                <a
                  href={enquireHref(day.date)}
                  class="cal-day cal-available"
                  data-date={day.date}
                  aria-label={`${longDate(day.date)}, available, enquire`}
                >
                  <span class="cal-daynum">{day.day}</span>
                </a>
              );
            })
          )}
        </div>
      </div>
    ))}
  </div>

  <!-- Legend -->
  <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mt-4 text-xs text-[var(--color-stone-grey)] dark:text-[var(--color-stone)]">
    <span class="flex items-center gap-1.5"><span class="legend-swatch legend-available" aria-hidden="true"></span> Available</span>
    <span class="flex items-center gap-1.5"><span class="legend-swatch legend-booked" aria-hidden="true"></span> Booked</span>
  </div>

  <!-- Enquiry bar (revealed by JS once a range/date is chosen) -->
  <div class="cal-enquire-bar" data-enquire-bar hidden>
    <div class="cal-enquire-text">
      <span data-enquire-summary></span>
    </div>
    <div class="cal-enquire-actions">
      <button type="button" class="cal-enquire-clear" data-enquire-clear>Clear</button>
      <a class="cal-enquire-airbnb" data-enquire-airbnb href="#" target="_blank" rel="noopener noreferrer">
        Check the price on Airbnb ↗
      </a>
      <a class="cal-enquire-cta" data-enquire-cta href="#">Enquire to book direct →</a>
    </div>
  </div>

  <p class="cal-pricing-note">
    We do not list nightly rates here because Airbnb's price changes with your
    dates and party size. Check the price on Airbnb for the dates you want,
    then book direct with us for {discountPercent}% less, with no platform fees.
  </p>
</div>

<style>
  .cal-day {
    min-height: 2.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    font-size: 0.78rem;
    text-decoration: none;
    line-height: 1.1;
    padding: 2px;
  }

  /* Available, green fill, high contrast, clearly interactive */
  .cal-available {
    background: color-mix(in srgb, var(--color-forest) 16%, white);
    color: var(--color-forest);
    font-weight: 600;
    cursor: pointer;
    transition: background 0.12s, transform 0.12s;
  }
  .cal-available:hover {
    background: color-mix(in srgb, var(--color-forest) 30%, white);
  }
  .cal-available:focus-visible {
    outline: 3px solid var(--color-ember);
    outline-offset: 1px;
  }
  :global(.dark) .cal-available {
    background: color-mix(in srgb, var(--color-forest) 40%, transparent);
    color: var(--color-forest);
  }
  :global(.dark) .cal-available:hover {
    background: color-mix(in srgb, var(--color-forest) 60%, transparent);
  }

  /* Booked, diagonal stripes + strikethrough (not colour-alone) */
  .cal-booked {
    background: repeating-linear-gradient(
      -45deg,
      color-mix(in srgb, var(--color-stone-grey) 22%, white),
      color-mix(in srgb, var(--color-stone-grey) 22%, white) 3px,
      color-mix(in srgb, var(--color-stone-grey) 10%, white) 3px,
      color-mix(in srgb, var(--color-stone-grey) 10%, white) 6px
    );
    color: var(--color-stone-grey);
  }
  .cal-booked span { text-decoration: line-through; opacity: 0.75; }
  :global(.dark) .cal-booked {
    background: repeating-linear-gradient(
      -45deg,
      color-mix(in srgb, var(--color-stone-grey) 70%, transparent),
      color-mix(in srgb, var(--color-stone-grey) 70%, transparent) 3px,
      color-mix(in srgb, var(--color-stone-grey) 40%, transparent) 3px,
      color-mix(in srgb, var(--color-stone-grey) 40%, transparent) 6px
    );
    color: var(--color-stone);
  }

  .cal-past { color: color-mix(in srgb, var(--color-stone-grey) 35%, transparent); }
  :global(.dark) .cal-past { color: color-mix(in srgb, var(--color-stone) 25%, transparent); }

  /* Selected range state (JS) */
  .cal-available.is-selected-end,
  .cal-available.is-selected-start {
    background: var(--color-ember);
    color: white;
  }
  :global(.dark) .cal-available.is-selected-start,
  :global(.dark) .cal-available.is-selected-end {
    background: var(--color-ember);
    color: white;
  }
  .cal-available.is-in-range {
    background: color-mix(in srgb, var(--color-ember) 22%, white);
    color: var(--color-link-hover);
    border-radius: 0;
  }
  :global(.dark) .cal-available.is-in-range {
    background: color-mix(in srgb, var(--color-ember) 35%, transparent);
    color: white;
  }

  .legend-swatch { width: 0.9rem; height: 0.9rem; border-radius: 0.25rem; display: inline-block; }
  .legend-available { background: color-mix(in srgb, var(--color-forest) 16%, white); border: 1px solid var(--color-forest); }
  :global(.dark) .legend-available { background: color-mix(in srgb, var(--color-forest) 40%, transparent); }
  .legend-booked {
    background: repeating-linear-gradient(-45deg,
      color-mix(in srgb, var(--color-stone-grey) 40%, white),
      color-mix(in srgb, var(--color-stone-grey) 40%, white) 2px,
      color-mix(in srgb, var(--color-stone-grey) 12%, white) 2px,
      color-mix(in srgb, var(--color-stone-grey) 12%, white) 4px);
  }

  .cal-pager {
    display: flex; align-items: center; justify-content: center; gap: 1rem; margin-bottom: 1rem;
  }
  .cal-pager-label { font-size: 0.9rem; font-weight: 600; min-width: 11rem; text-align: center; }
  .cal-pager-btn {
    width: 2.25rem; height: 2.25rem; border-radius: 9999px; border: 1px solid var(--color-hairline);
    background: var(--color-snow); color: var(--color-schist-ink); cursor: pointer;
    display: flex; align-items: center; justify-content: center; transition: background 0.12s, opacity 0.12s;
  }
  :global(.dark) .cal-pager-btn { background: var(--color-schist-ink); color: var(--color-snow); border-color: var(--color-stone-grey); }
  .cal-pager-btn:hover:not(:disabled) { background: var(--color-hairline); }
  :global(.dark) .cal-pager-btn:hover:not(:disabled) { background: var(--color-stone-grey); }
  .cal-pager-btn:disabled { opacity: 0.35; cursor: not-allowed; }
  .cal-pager-btn:focus-visible { outline: 3px solid var(--color-ember); outline-offset: 2px; }
  .cal-pager-btn svg { width: 1.1rem; height: 1.1rem; }
  /* When JS enables paging, only the active pair of months is shown. */
  .cal-month.is-hidden { display: none; }

  .cal-enquire-bar {
    display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; justify-content: space-between;
    margin-top: 1rem; padding: 0.85rem 1rem; border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-ember) 8%, white);
    border: 1px solid color-mix(in srgb, var(--color-ember) 35%, transparent);
  }
  :global(.dark) .cal-enquire-bar { background: color-mix(in srgb, var(--color-ember) 15%, transparent); }
  .cal-enquire-text { font-size: 0.85rem; font-weight: 600; }
  .cal-enquire-actions { display: flex; align-items: center; gap: 0.75rem; }
  .cal-enquire-clear {
    background: none; border: 0; cursor: pointer; font-size: 0.8rem;
    color: var(--color-stone-grey); text-decoration: underline;
  }
  .cal-enquire-cta {
    display: inline-block; background: var(--color-ember); color: white;
    padding: 0.5rem 0.9rem; border-radius: 0.6rem; font-size: 0.85rem; font-weight: 600; text-decoration: none;
    transition: background 0.12s;
  }
  .cal-enquire-cta:hover { background: var(--color-link-hover); }
  .cal-enquire-airbnb {
    font-size: 0.8rem; font-weight: 600; text-decoration: underline;
    color: var(--color-graphite);
  }
  :global(.dark) .cal-enquire-airbnb { color: var(--color-stone); }
  .cal-enquire-airbnb:hover { color: var(--color-ember); }

  .cal-guests {
    border: 1px solid var(--color-hairline);
    border-radius: 0.75rem; padding: 0.85rem 1rem; margin-bottom: 1rem;
  }
  :global(.dark) .cal-guests { border-color: var(--color-stone-grey); }
  .cal-guests-legend {
    font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--color-stone-grey); padding: 0 0.25rem;
  }
  :global(.dark) .cal-guests-legend { color: var(--color-stone); }
  .cal-guests-fields { display: flex; flex-wrap: wrap; gap: 1rem; }
  .cal-guest-field { display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; font-weight: 600; }
  .cal-guest-field input {
    width: 4.25rem; box-sizing: border-box; font: inherit;
    border: 1px solid var(--color-hairline); border-radius: 0.5rem;
    padding: 0.35rem 0.5rem; background: white; color: var(--color-graphite);
  }
  :global(.dark) .cal-guest-field input {
    background: var(--color-schist-ink); color: var(--color-stone);
    border-color: var(--color-stone-grey);
  }
  .cal-guest-field input:focus-visible { outline: 3px solid var(--color-ember); outline-offset: 1px; }
  .cal-guests-note {
    margin-top: 0.5rem; font-size: 0.75rem; color: var(--color-stone-grey);
  }
  :global(.dark) .cal-guests-note { color: var(--color-stone); }
  .cal-guests-note.is-capped { color: var(--color-ember); font-weight: 600; }

  .cal-pricing-note {
    margin-top: 1rem; font-size: 0.8rem; line-height: 1.6;
    color: var(--color-stone-grey);
  }
  :global(.dark) .cal-pricing-note { color: var(--color-stone); }
</style>

<script>
  import { airbnbListingUrl } from '../lib/airbnb-links';

  function initAvailability() {
    document.querySelectorAll<HTMLElement>('[data-availability]').forEach((root) => {
      const stayType = root.dataset.stayType ?? 'general';
      const maxGuests = Number(root.dataset.maxGuests) || 2;
      const airbnbUrl = root.dataset.airbnbUrl ?? '';
      const days = Array.from(root.querySelectorAll<HTMLAnchorElement>('.cal-available'));
      const bar = root.querySelector<HTMLElement>('[data-enquire-bar]');
      const summary = root.querySelector<HTMLElement>('[data-enquire-summary]');
      const cta = root.querySelector<HTMLAnchorElement>('[data-enquire-cta]');
      const airbnbCta = root.querySelector<HTMLAnchorElement>('[data-enquire-airbnb]');
      const clearBtn = root.querySelector<HTMLButtonElement>('[data-enquire-clear]');
      const adultsInput = root.querySelector<HTMLInputElement>('[data-guests-adults]');
      const childrenInput = root.querySelector<HTMLInputElement>('[data-guests-children]');
      const guestsNote = root.querySelector<HTMLElement>('[data-guests-note]');
      if (days.length === 0 || !bar || !summary || !cta) return;

      // Party size, clamped to what the stay actually sleeps. Adults win when
      // the total overflows, since dropping an adult can invalidate the whole
      // booking whereas trimming a child count is usually a typo.
      const readGuests = () => {
        let adults = Math.max(1, Math.floor(Number(adultsInput?.value) || 1));
        let children = Math.max(0, Math.floor(Number(childrenInput?.value) || 0));
        let capped = false;

        if (adults > maxGuests) { adults = maxGuests; capped = true; }
        if (adults + children > maxGuests) { children = maxGuests - adults; capped = true; }

        if (adultsInput && Number(adultsInput.value) !== adults) adultsInput.value = String(adults);
        if (childrenInput && Number(childrenInput.value) !== children) childrenInput.value = String(children);

        if (guestsNote) {
          guestsNote.textContent = capped
            ? `This stay sleeps up to ${maxGuests}, so we have adjusted your party to fit.`
            : `This stay sleeps up to ${maxGuests}.`;
          guestsNote.classList.toggle('is-capped', capped);
        }
        return { adults, children };
      };

      const guestLabel = (adults: number, children: number) =>
        `${adults} adult${adults === 1 ? '' : 's'}` +
        (children > 0 ? `, ${children} child${children === 1 ? '' : 'ren'}` : '');

      const dates = days.map((d) => d.dataset.date!).sort();
      let checkin: string | null = null;
      let checkout: string | null = null;

      const fmt = (iso: string) =>
        new Date(iso + 'T00:00:00Z').toLocaleDateString('en-NZ', {
          day: 'numeric', month: 'short', timeZone: 'UTC',
        });

      const nextDay = (iso: string) => {
        const d = new Date(iso + 'T00:00:00Z');
        d.setUTCDate(d.getUTCDate() + 1);
        return d.toISOString().slice(0, 10);
      };

      const nightsBetween = (a: string, b: string) => {
        let nights = 0;
        for (let cur = a; cur < b; cur = nextDay(cur)) nights++;
        return nights;
      };

      const clearClasses = () =>
        days.forEach((d) => d.classList.remove('is-selected-start', 'is-selected-end', 'is-in-range'));

      // Are all nights in [a, b) available? Booked days aren't in `dates`,
      // so a gap means the range crosses a booked night.
      const availableSet = new Set(dates);
      const rangeIsClear = (a: string, b: string) => {
        let cur = a;
        while (cur < b) {
          if (!availableSet.has(cur)) return false;
          const next = new Date(cur + 'T00:00:00Z');
          next.setUTCDate(next.getUTCDate() + 1);
          cur = next.toISOString().slice(0, 10);
        }
        return true;
      };

      // Both CTAs carry the party size: the enquiry so we quote the right
      // price, and Airbnb so the rate it shows already includes extra-guest
      // fees for this party rather than a two-person default.
      const contactHref = (
        adults: number,
        children: number,
        dateParams: Record<string, string>
      ) => {
        const qs = new URLSearchParams({ stay: stayType, ...dateParams });
        qs.set('adults', String(adults));
        qs.set('children', String(children));
        return `/contact?${qs.toString()}`;
      };

      const render = () => {
        clearClasses();
        const { adults, children } = readGuests();

        if (checkin && !checkout) {
          const el = days.find((d) => d.dataset.date === checkin);
          el?.classList.add('is-selected-start');
          summary.textContent = `Check-in ${fmt(checkin)}, now pick a check-out date`;
          cta.href = contactHref(adults, children, { date: checkin });
          if (airbnbCta && airbnbUrl) {
            airbnbCta.href = airbnbListingUrl(airbnbUrl, { checkIn: checkin, adults, children });
          }
          bar.hidden = false;
        } else if (checkin && checkout) {
          days.forEach((d) => {
            const dt = d.dataset.date!;
            if (dt === checkin) d.classList.add('is-selected-start');
            else if (dt === checkout) d.classList.add('is-selected-end');
            else if (dt > checkin && dt < checkout) d.classList.add('is-in-range');
          });
          const nights = nightsBetween(checkin, checkout);
          summary.textContent =
            `${fmt(checkin)} → ${fmt(checkout)} · ${nights} night${nights > 1 ? 's' : ''}` +
            ` · ${guestLabel(adults, children)}`;
          cta.href = contactHref(adults, children, { checkin, checkout });
          if (airbnbCta && airbnbUrl) {
            airbnbCta.href = airbnbListingUrl(airbnbUrl, {
              checkIn: checkin,
              checkOut: checkout,
              adults,
              children,
            });
          }
          bar.hidden = false;
        } else {
          bar.hidden = true;
        }
      };

      // Changing party size after picking dates must update both links.
      adultsInput?.addEventListener('input', render);
      childrenInput?.addEventListener('input', render);

      days.forEach((day) => {
        day.addEventListener('click', (e) => {
          e.preventDefault(); // JS takes over; link is the no-JS fallback
          const date = day.dataset.date!;
          if (!checkin || checkout) {
            checkin = date;
            checkout = null;
          } else if (date <= checkin) {
            checkin = date; // restart if they pick an earlier/same day
            checkout = null;
          } else if (rangeIsClear(checkin, date)) {
            checkout = date;
          } else {
            checkin = date; // range crossed a booked night, restart
            checkout = null;
          }
          render();
        });
      });

      clearBtn?.addEventListener('click', () => {
        checkin = null;
        checkout = null;
        render();
      });

      // --- Month paging (show 2 months at a time) ---
      const monthCards = Array.from(root.querySelectorAll<HTMLElement>('.cal-month'));
      const pager = root.querySelector<HTMLElement>('[data-pager]');
      const pagePrev = root.querySelector<HTMLButtonElement>('[data-page-prev]');
      const pageNext = root.querySelector<HTMLButtonElement>('[data-page-next]');
      const pageLabel = root.querySelector<HTMLElement>('[data-page-label]');
      const PER_PAGE = 2;

      if (pager && monthCards.length > PER_PAGE) {
        pager.hidden = false;
        const pageCount = Math.ceil(monthCards.length / PER_PAGE);
        let page = 0;

        const showPage = (p: number) => {
          page = Math.max(0, Math.min(pageCount - 1, p));
          monthCards.forEach((card, i) => {
            const onPage = i >= page * PER_PAGE && i < (page + 1) * PER_PAGE;
            card.classList.toggle('is-hidden', !onPage);
          });
          const visible = monthCards.slice(page * PER_PAGE, page * PER_PAGE + PER_PAGE);
          const labels = visible.map((c) => c.dataset.monthLabel ?? '');
          if (pageLabel) pageLabel.textContent = labels.join(' – ');
          if (pagePrev) pagePrev.disabled = page === 0;
          if (pageNext) pageNext.disabled = page === pageCount - 1;
        };

        pagePrev?.addEventListener('click', () => showPage(page - 1));
        pageNext?.addEventListener('click', () => showPage(page + 1));
        showPage(0);
      }
    });
  }

  initAvailability();
  document.addEventListener('astro:page-load', initAvailability);
</script>
