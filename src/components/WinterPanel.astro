---
import winterData from '../data/winter-conditions.json';

const STALE_AFTER_MS = 48 * 60 * 60 * 1000;
const generatedAt = new Date(winterData.generatedAt);
const isStale = !winterData.generatedAt || Date.now() - generatedAt.getTime() > STALE_AFTER_MS;

const updatedLabel = winterData.generatedAt
  ? new Intl.DateTimeFormat('en-NZ', {
      day: 'numeric',
      month: 'short',
      hour: 'numeric',
      minute: '2-digit',
      timeZone: 'Pacific/Auckland',
    }).format(generatedAt) + ' NZT'
  : null;

const fields = winterData.fields ?? [];
---

<div id="winter-conditions" class="mt-10 scroll-mt-24 rounded-2xl border border-[var(--color-hairline)] bg-white p-6">
  <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
    <div class="flex items-center gap-2">
      <span class="text-xl" aria-hidden="true">❄️</span>
      <h3 class="text-lg font-medium">Winter conditions</h3>
    </div>
    {updatedLabel && !isStale && (
      <span class="text-xs text-[var(--color-stone-grey)]">Last updated: {updatedLabel}</span>
    )}
  </div>
  <p class="text-sm text-[var(--color-stone-grey)] mb-4">
    Heading up the hill? Live figures for The Remarkables, Coronet Peak and Cardrona, refreshed through the day. Every figure links back to its source so you can double-check it yourself.
  </p>

  {!isStale && fields.length > 0 && (
    <div class="divide-y divide-[var(--color-hairline)] border-t border-[var(--color-hairline)]">
      {fields.map((field) => (
        <div class="py-3 flex flex-col sm:flex-row sm:items-baseline gap-x-4 gap-y-1.5">
          <div class="sm:w-32 flex-shrink-0 flex items-baseline gap-1.5">
            <span class="text-sm font-semibold">{field.name}</span>
            {field.status && <span class="text-xs text-[var(--color-stone-grey)]">{field.status}</span>}
          </div>
          <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
            {field.facts.map((fact) =>
              fact.ok ? (
                <span class="text-[var(--color-stone-grey)]">
                  <span class="text-[var(--color-graphite)] font-medium">{fact.label}:</span> {fact.value}
                </span>
              ) : (
                <a href={fact.sourceUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[var(--color-ember)]">
                  {fact.label} <span aria-hidden="true">↗</span>
                </a>
              )
            )}
          </div>
        </div>
      ))}
    </div>
  )}

  {isStale && (
    <div class="border-t border-[var(--color-hairline)] pt-3 flex flex-wrap gap-x-4 gap-y-1">
      {fields.map((field) => (
        <a href={field.facts[0]?.sourceUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-sm font-medium text-[var(--color-ember)]">
          {field.name} snow report <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  )}

  {isStale && (
    <p class="text-xs text-[var(--color-stone-grey)] mt-3">
      Live figures are due to refresh; showing source links until they're back.
    </p>
  )}
</div>
