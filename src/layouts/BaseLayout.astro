---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
}

const { title, description, ogImage, canonicalUrl, noindex = false } = Astro.props;
const siteTitle = 'Remarkable BnB';
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const desc = description || 'Accommodation at Holly and Julian\'s home in Hanley\'s Farm, Queenstown. Near The Remarkables ski field and Jack\'s Point golf course. Book direct and save.';
const canonical = canonicalUrl || Astro.url.href;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Open Graph -->
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:site_name" content={siteTitle} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={desc} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}

  <style is:global>
    @import '../styles/global.css';
  </style>
</head>
<body class="min-h-screen flex flex-col">
  <!-- Navigation (navy accent band) -->
  <header class="sticky top-0 z-50 backdrop-blur-md bg-[var(--color-schist-ink)]/95 border-b border-white/10">
    <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2.5 group" id="nav-home">
        <span class="w-7 h-7 rounded-full border border-[var(--color-cream)]/60 flex items-center justify-center font-serif text-sm text-[var(--color-cream)]" aria-hidden="true">R</span>
        <span class="font-serif text-lg text-[var(--color-cream)] group-hover:text-[var(--color-ember)] transition-colors">
          Remarkable BnB
        </span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden md:flex items-center gap-8">
        <a href="/#stays" class="text-sm font-medium text-[var(--color-cream)]/80 hover:text-[var(--color-cream)] transition-colors" id="nav-stays">Stays</a>

        <!-- Guides: both guide pages reachable, hover/focus dropdown, no JS required -->
        <div class="relative group">
          <a
            href="/guides/things-to-do"
            class="inline-flex items-center gap-1 text-sm font-medium text-[var(--color-cream)]/80 hover:text-[var(--color-cream)] transition-colors"
            id="nav-guides"
            aria-haspopup="true"
          >
            Guides
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          </a>
          <div class="absolute left-1/2 -translate-x-1/2 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-150 z-50">
            <div class="bg-[var(--color-schist-ink)] border border-white/10 rounded-xl shadow-lg py-2 min-w-[200px]">
              <a href="/guides/eat-and-drink" class="block px-4 py-2 text-sm text-[var(--color-cream)]/80 hover:text-[var(--color-cream)] hover:bg-white/10 transition-colors" id="nav-guides-eat">Where to eat and drink</a>
              <a href="/guides/things-to-do" class="block px-4 py-2 text-sm text-[var(--color-cream)]/80 hover:text-[var(--color-cream)] hover:bg-white/10 transition-colors" id="nav-guides-things-to-do">Things to do</a>
            </div>
          </div>
        </div>

        <a href="/reviews" class="text-sm font-medium text-[var(--color-cream)]/80 hover:text-[var(--color-cream)] transition-colors" id="nav-reviews">Reviews</a>
        <a href="/contact" class="text-sm font-medium text-[var(--color-cream)]/80 hover:text-[var(--color-cream)] transition-colors" id="nav-contact">Contact</a>
        <a href="/#winter-conditions" class="text-lg text-[var(--color-cream)]/80 hover:text-[var(--color-cream)] transition-colors" id="nav-winter" aria-label="Jump to winter conditions" title="Winter conditions">❄️</a>
      </div>

      <!-- Mobile menu button -->
      <button
        type="button"
        class="md:hidden p-2 rounded-lg text-[var(--color-cream)]/80 hover:bg-white/10 transition-colors"
        id="mobile-menu-btn"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </nav>

    <!-- Mobile menu -->
    <div class="md:hidden hidden border-t border-white/10" id="mobile-menu">
      <div class="px-4 py-3 space-y-1">
        <a href="/stays/two-bedroom-unit" class="block px-3 py-2 rounded-lg text-sm font-medium text-[var(--color-cream)]/80 hover:bg-white/10">Two Bedroom Unit</a>
        <a href="/stays/guest-room" class="block px-3 py-2 rounded-lg text-sm font-medium text-[var(--color-cream)]/80 hover:bg-white/10">Guest Room</a>
        <a href="/guides/eat-and-drink" class="block px-3 py-2 rounded-lg text-sm font-medium text-[var(--color-cream)]/80 hover:bg-white/10">Eat & drink guide</a>
        <a href="/guides/things-to-do" class="block px-3 py-2 rounded-lg text-sm font-medium text-[var(--color-cream)]/80 hover:bg-white/10">Things to do guide</a>
        <a href="/reviews" class="block px-3 py-2 rounded-lg text-sm font-medium text-[var(--color-cream)]/80 hover:bg-white/10">Reviews</a>
        <a href="/contact" class="block px-3 py-2 rounded-lg text-sm font-medium text-[var(--color-cream)]/80 hover:bg-white/10">Contact</a>
        <a href="/#winter-conditions" class="block px-3 py-2 rounded-lg text-sm font-medium text-[var(--color-cream)]/80 hover:bg-white/10">❄️ Winter conditions</a>
      </div>
    </div>
  </header>

  <!-- Main content -->
  <main class="flex-1">
    <slot />
  </main>

  <!-- Footer (schist-ink band) -->
  <footer class="bg-[var(--color-schist-ink)] text-[var(--color-cream)]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Brand -->
        <div>
          <div class="flex items-center gap-2.5 mb-2">
            <span class="w-7 h-7 rounded-full border border-[var(--color-cream)]/60 flex items-center justify-center font-serif text-sm" aria-hidden="true">R</span>
            <h3 class="font-serif text-lg m-0">Remarkable BnB</h3>
          </div>
          <p class="text-sm text-[var(--color-cream-muted)]">
            Under The Remarkables.<br />
            Holly & Julian, your hosts.
          </p>
        </div>

        <!-- Stays -->
        <div>
          <h4 class="text-sm font-semibold uppercase tracking-widest text-[var(--color-cream-muted)] mb-3">Our Stays</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/stays/two-bedroom-unit" class="text-[var(--color-cream)]/80 hover:text-[var(--color-cream)] transition-colors">Two Bedroom Unit</a></li>
            <li><a href="/stays/guest-room" class="text-[var(--color-cream)]/80 hover:text-[var(--color-cream)] transition-colors">Guest Room</a></li>
          </ul>
        </div>

        <!-- Quick links -->
        <div>
          <h4 class="text-sm font-semibold uppercase tracking-widest text-[var(--color-cream-muted)] mb-3">Quick Links</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/reviews" class="text-[var(--color-cream)]/80 hover:text-[var(--color-cream)] transition-colors">Reviews</a></li>
            <li><a href="/contact" class="text-[var(--color-cream)]/80 hover:text-[var(--color-cream)] transition-colors">Contact Us</a></li>
            <li><a href="/guides/eat-and-drink" class="text-[var(--color-cream)]/80 hover:text-[var(--color-cream)] transition-colors">Eat & drink guide</a></li>
            <li><a href="/guides/things-to-do" class="text-[var(--color-cream)]/80 hover:text-[var(--color-cream)] transition-colors">Things to do guide</a></li>
            <li><a href="/terms" class="text-[var(--color-cream)]/80 hover:text-[var(--color-cream)] transition-colors">Booking terms</a></li>
          </ul>
        </div>
      </div>

      <div class="mt-8 pt-6 border-t border-white/10">
        <p class="text-xs text-[var(--color-cream-muted)] text-center">
          &copy; {new Date().getFullYear()} Remarkable BnB. Hanley's Farm, Queenstown, New Zealand.
        </p>
      </div>
    </div>
  </footer>

  <!-- Mobile menu toggle script -->
  <script>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (btn && menu) {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        menu.classList.toggle('hidden');
      });
    }
  </script>
</body>
</html>
