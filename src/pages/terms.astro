---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

export const prerender = true;

// All copy lives in src/content/pages/terms.md, this page is chrome only.
const page = (await getEntry('pages', 'terms'))!;
const { Content } = await render(page);
---

<BaseLayout title={page.data.seoTitle} description={page.data.seoDescription}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="mb-12">
      {page.data.badge && <span class="badge badge-ember mb-3">{page.data.badge}</span>}
      <h1 class="text-4xl sm:text-5xl font-medium mb-4">{page.data.heading}</h1>
      {page.data.intro && (
        <p class="text-[var(--color-stone-grey)] max-w-xl">{page.data.intro}</p>
      )}
    </div>

    <div class="prose prose-slate dark:prose-invert max-w-none prose-headings:font-medium prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-3 prose-p:text-sm prose-p:text-[var(--color-stone-grey)] prose-p:leading-relaxed prose-li:text-sm prose-li:text-[var(--color-stone-grey)] prose-li:leading-relaxed prose-strong:text-[var(--color-graphite)] dark:prose-strong:text-[var(--color-cream)] marker:text-[var(--color-ember)]">
      <Content />
    </div>

    <div class="mt-12 pt-8 border-t border-[var(--color-hairline)]">
      <p class="text-sm text-[var(--color-stone-grey)]">
        Questions about any of this? <a href="/contact" class="text-[var(--color-ember)] font-semibold hover:underline">Get in touch</a> before you book.
      </p>
    </div>
  </div>
</BaseLayout>
