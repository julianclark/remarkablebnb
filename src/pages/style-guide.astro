---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';

const colors = [
  { name: 'schist-ink', var: '--color-schist-ink', hex: '#1a1714', use: 'Dark UI surfaces: footer, TV mode, dark section bands' },
  { name: 'graphite', var: '--color-graphite', hex: '#262320', use: 'Headings, primary body text' },
  { name: 'stone-grey', var: '--color-stone-grey', hex: '#5c564c', use: 'Secondary/body copy, borders on dark (6.5:1 on plaster)' },
  { name: 'taupe', var: '--color-taupe', hex: '#857c6f', use: 'Muted meta and caption text' },
  { name: 'plaster', var: '--color-plaster', hex: '#f5f1ea', use: 'Page background' },
  { name: 'snow', var: '--color-snow', hex: '#fffefb', use: 'Card and panel surfaces' },
  { name: 'hairline', var: '--color-hairline', hex: '#e4dcce', use: 'Borders, dividers' },
  { name: 'fill', var: '--color-fill', hex: '#efe7d9', use: 'Fact-pill and chip tinted backgrounds' },
  { name: 'stone', var: '--color-stone', hex: '#d9cdb8', use: 'Input borders, decorative fills' },
  { name: 'larch', var: '--color-larch', hex: '#b79a6d', use: 'Warm wood, decorative only, never text' },
  { name: 'cedar', var: '--color-cedar', hex: '#8a6b45', use: 'Deep wood, large text only' },
  { name: 'ember', var: '--color-ember', hex: '#99502f', use: 'Primary CTA and default links (5.9:1 on plaster, passes AA)' },
  { name: 'link-hover', var: '--color-link-hover', hex: '#7f3f24', use: 'Link/CTA hover and press, light surfaces' },
  { name: 'visited', var: '--color-visited', hex: '#7a4a3e', use: 'Visited links, never browser purple' },
  { name: 'ember-dark-hover', var: '--color-ember-dark-hover', hex: '#c76d47', use: 'Ember CTA hover specifically on dark surfaces' },
  { name: 'alpenglow', var: '--color-alpenglow', hex: '#b5613e', use: 'Accent, large display text and icon fills only (4.4:1)' },
  { name: 'sun-gold', var: '--color-sun-gold', hex: '#cf8a3c', use: 'Favourite marks, stars: decorative only, never text on light (2.5-2.8:1)' },
  { name: 'sun-gold-dark', var: '--color-sun-gold-dark', hex: '#a86a1f', use: 'AA-safe gold variant for badge text' },
  { name: 'pine-teal', var: '--color-pine-teal', hex: '#47716f', use: 'Secondary accent badges (e.g. "Top 1%")' },
  { name: 'forest', var: '--color-forest', hex: '#4b6b4a', use: 'Success, positive/nature accent' },
  { name: 'cream', var: '--color-cream', hex: '#f0e6d8', use: 'Text on dark surfaces' },
  { name: 'cream-muted', var: '--color-cream-muted', hex: '#b3a795', use: 'Muted text on dark surfaces' },
];
---

<BaseLayout
  title="Style Guide"
  description="Internal design reference for Remarkable BnB: tokens and UI patterns."
  noindex={true}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">
    <header>
      <div class="flex flex-wrap items-center gap-3 mb-3">
        <p class="text-sm font-medium text-[var(--color-ember)] uppercase tracking-widest">Internal reference</p>
        <span class="badge badge-ember">Design System v1.1</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-medium mb-4">Remarkable BnB style guide</h1>
      <p class="text-[var(--color-stone-grey)] max-w-2xl">
        A living catalog of the tokens, type scale and UI patterns already in use across the site, pulled
        straight from <code class="text-sm bg-[var(--color-hairline)]/50 px-1.5 py-0.5 rounded">src/styles/global.css</code>
        and the components in <code class="text-sm bg-[var(--color-hairline)]/50 px-1.5 py-0.5 rounded">src/components/</code>.
        Not linked in navigation; not indexed by search engines.
      </p>
    </header>

    <!-- Voice -->
    <section>
      <h2 class="text-2xl font-medium mb-4">Brand & voice</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
        <div class="rounded-xl border border-[var(--color-hairline)] p-4">
          <span class="block font-semibold mb-1">Who we are</span>
          <span class="text-[var(--color-stone-grey)]">Personal hosts, not a property company. First-person plural ("we", "our home"). Holly & Julian named and visible.</span>
        </div>
        <div class="rounded-xl border border-[var(--color-hairline)] p-4">
          <span class="block font-semibold mb-1">Positioning</span>
          <span class="text-[var(--color-stone-grey)]">Destination stay: mountains, snow, Remarkables access, Jack's Point golf. Not Queenstown CBD.</span>
        </div>
        <div class="rounded-xl border border-[var(--color-hairline)] p-4">
          <span class="block font-semibold mb-1">Tagline</span>
          <span class="text-[var(--color-stone-grey)]">"Remarkable BnB, under The Remarkables."</span>
        </div>
        <div class="rounded-xl border border-[var(--color-hairline)] p-4">
          <span class="block font-semibold mb-1">Tone</span>
          <span class="text-[var(--color-stone-grey)]">Specific, warm, never salesy. No exclamation-mark marketing copy. Always honest about direct-vs-Airbnb tradeoffs.</span>
        </div>
      </div>
    </section>

    <!-- Copy rules -->
    <section>
      <h2 class="text-2xl font-medium mb-4">Copy rules</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
        <div class="rounded-xl border border-[var(--color-hairline)] p-4">
          <span class="block font-semibold mb-1">No em dashes</span>
          <span class="text-[var(--color-stone-grey)]">Never in site copy. The only exception is verbatim guest review quotes, reproduced exactly as written.</span>
        </div>
        <div class="rounded-xl border border-[var(--color-hairline)] p-4">
          <span class="block font-semibold mb-1">NZ English spelling</span>
          <span class="text-[var(--color-stone-grey)]">favourite, cosy, neighbourhood, colour. Throughout, no exceptions.</span>
        </div>
        <div class="rounded-xl border border-[var(--color-hairline)] p-4">
          <span class="block font-semibold mb-1">No exclamation-mark marketing</span>
          <span class="text-[var(--color-stone-grey)]">Specific and warm, never salesy or hyped. State the honest fact rather than sell it.</span>
        </div>
        <div class="rounded-xl border border-[var(--color-hairline)] p-4">
          <span class="block font-semibold mb-1">Real details and real reviews only</span>
          <span class="text-[var(--color-stone-grey)]">Never invent tips, stories, years, personality traits or reviews. Guest quotes are verbatim and correctly attributed. Fabricated "personal" touches are worse than none.</span>
        </div>
      </div>
    </section>

    <!-- Color -->
    <section>
      <h2 class="text-2xl font-medium mb-1">Color</h2>
      <p class="text-sm text-[var(--color-stone-grey)] mb-6">Warm alpenglow palette, pulled from the schist, snow, cedar and alpenglow of the site itself. Defined once in the <code>@theme</code> block, used everywhere as <code>var(--color-*)</code>. Never a raw hex in a component.</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        {colors.map((c) => (
          <div class="rounded-xl border border-[var(--color-hairline)] overflow-hidden">
            <div class="h-20" style={`background-color:${c.hex}`}></div>
            <div class="p-3">
              <span class="block text-sm font-semibold">{c.name}</span>
              <span class="block text-xs text-[var(--color-stone-grey)] font-mono">{c.hex}</span>
              <span class="block text-xs text-[var(--color-stone-grey)] mt-1">{c.use}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Typography -->
    <section>
      <h2 class="text-2xl font-medium mb-1">Typography</h2>
      <p class="text-sm text-[var(--color-stone-grey)] mb-6">
        <strong class="font-serif not-italic">Newsreader</strong> (display serif: headlines, taglines, pull-quotes, warm italic) +
        <strong> Hanken Grotesk</strong> (text and UI, tabular numerals for rates and dates). Both self-hosted as
        subset WOFF2 with <code>font-display: swap</code>. Headings: <code>font-serif</code>, weight 500, tight leading, slightly negative tracking.
      </p>
      <div class="space-y-4 rounded-xl border border-[var(--color-hairline)] p-6">
        <p class="text-sm font-medium text-[var(--color-stone-grey)] uppercase tracking-widest">Overline: text-sm uppercase tracking-widest</p>
        <h1 class="text-4xl sm:text-5xl font-medium leading-tight">Display / Hero headline: text-4xl/5xl</h1>
        <h2 class="text-3xl font-medium">H1 / Page headline: text-3xl</h2>
        <p class="font-serif text-2xl">H2 / Section headline: text-2xl font-serif</p>
        <h3 class="text-lg font-medium">Card / panel title: font-medium</h3>
        <p class="font-serif italic text-xl text-[var(--color-ember)]">Tagline italic: "Remarkable BnB, under The Remarkables."</p>
        <p class="text-lg text-[var(--color-stone-grey)]">Lead paragraph: text-lg</p>
        <p class="text-sm text-[var(--color-stone-grey)]">Body copy: text-sm, line-height 1.7 on body</p>
        <p class="text-xs text-[var(--color-stone-grey)]">Meta / caption: text-xs</p>
      </div>
    </section>

    <!-- Link states -->
    <section>
      <h2 class="text-2xl font-medium mb-1">Link states</h2>
      <p class="text-sm text-[var(--color-stone-grey)] mb-6">
        All four states are explicit, from the token palette, in <code>global.css</code>. Focus rings are never
        removed, only restyled. Nothing is left to render as browser-default blue or purple.
      </p>
      <div class="flex flex-wrap gap-x-8 gap-y-3 text-sm rounded-xl border border-[var(--color-hairline)] p-6">
        <span><a href="#">Link</a>: ember, #99502F, AA on plaster</span>
        <span class="text-[var(--color-link-hover)]">Hover: link-hover, #7F3F24</span>
        <span class="text-[var(--color-visited)]">Visited: visited, #7A4A3E, muted, never purple</span>
        <span class="inline-flex items-center gap-2">Focus <kbd class="text-xs border border-[var(--color-ember)] rounded px-1.5 py-0.5">Tab</kbd>: 2px ember outline, always kept</span>
      </div>
    </section>

    <!-- Ground rules -->
    <section>
      <h2 class="text-2xl font-medium mb-1">Ground rules</h2>
      <p class="text-sm text-[var(--color-stone-grey)] mb-6">The non-negotiables that keep the system accessible, honest and on-brand.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
        <div class="rounded-xl border border-[var(--color-hairline)] p-4">
          <span class="block font-semibold mb-1">Icons are visible by default</span>
          <span class="text-[var(--color-stone-grey)]">Never hide an icon or action behind hover. Stars, arrows and status dots carry meaning, so they render at rest, on touch and with a keyboard. Hover only enhances, it never reveals.</span>
        </div>
        <div class="rounded-xl border border-[var(--color-hairline)] p-4 bg-[var(--color-schist-ink)] text-[var(--color-cream)]">
          <span class="block font-semibold mb-1">On dark surfaces</span>
          <span class="text-[var(--color-cream-muted)]">Text goes cream (#F0E6D8). Primary CTAs keep ember and lighten to #C76D47 on hover. Secondary buttons take a translucent cream border.</span>
        </div>
        <div class="rounded-xl border border-[var(--color-hairline)] p-4">
          <span class="block font-semibold mb-1">Imagery</span>
          <span class="text-[var(--color-stone-grey)]">Real site photography, always. A striped placeholder with a mono label when a shot is missing. An ink scrim under any text over a photo. Descriptive alt text on every image. No guest faces without consent. Never hand-drawn SVG scenes.</span>
        </div>
        <div class="rounded-xl border border-[var(--color-hairline)] p-4">
          <span class="block font-semibold mb-1">Copy: do</span>
          <span class="text-[var(--color-stone-grey)]">First person plural ("we", "our home"). Warm, specific and honest, showing both booking paths plainly. Reviews verbatim, correctly attributed. Obviously-fake placeholders in every mock (your-network-name, your-password, 0000).</span>
        </div>
        <div class="rounded-xl border border-[var(--color-hairline)] p-4 sm:col-span-2">
          <span class="block font-semibold mb-1">Copy: don't</span>
          <span class="text-[var(--color-stone-grey)]">No exclamation-mark marketing or salesy claims. No invented promises ("reply within the hour"). No em dashes, use commas, colons or full stops. Never publish the returning-guest discount figure.</span>
        </div>
      </div>
    </section>

    <!-- Spacing -->
    <section>
      <h2 class="text-2xl font-medium mb-1">Spacing & layout</h2>
      <p class="text-sm text-[var(--color-stone-grey)] mb-6">Every section shares one wrapper shape. Content max-width is <code>max-w-6xl</code> (narrower, <code>max-w-3xl</code>/<code>max-w-4xl</code>, for text-heavy pages).</p>
      <div class="rounded-xl border border-dashed border-[var(--color-ember)]/40 p-4 font-mono text-xs text-[var(--color-stone-grey)] overflow-x-auto">
        &lt;section class="py-16 sm:py-20"&gt;<br />
        &nbsp;&nbsp;&lt;div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8"&gt;...&lt;/div&gt;<br />
        &lt;/section&gt;
      </div>
    </section>

    <!-- Badges -->
    <section>
      <h2 class="text-2xl font-medium mb-1">Badges</h2>
      <p class="text-sm text-[var(--color-stone-grey)] mb-6"><code>.badge</code> base class + one color modifier.</p>
      <div class="flex flex-wrap gap-3">
        <span class="badge badge-gold">Gold badge</span>
        <span class="badge badge-ember">Alpine badge</span>
        <span class="badge badge-forest">Forest badge</span>
      </div>
    </section>

    <!-- Buttons / CTAs -->
    <section>
      <h2 class="text-2xl font-medium mb-1">Buttons & CTAs</h2>
      <p class="text-sm text-[var(--color-stone-grey)] mb-6">Always paired: primary (Book Direct) + secondary (Book on Airbnb), from <code>BookingCTA.astro</code>. Honest framing note underneath, never omitted.</p>
      <div class="max-w-sm space-y-3">
        <a href="#" class="group block w-full rounded-xl bg-[var(--color-ember)] hover:bg-[var(--color-link-hover)] text-white px-5 py-4 transition-all duration-200 hover:shadow-lg hover:shadow-[var(--color-ember)]/25 hover:-translate-y-0.5">
          <div class="flex items-center justify-between gap-3">
            <div class="min-w-0">
              <div class="font-bold text-lg leading-tight">Book Direct: Save 10%</div>
              <div class="text-sm text-white/80 mt-0.5">No platform fees, personal service</div>
            </div>
            <svg class="w-5 h-5 flex-shrink-0 text-white/60 group-hover:text-white group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </div>
        </a>
        <a href="#" class="group block w-full rounded-xl border-2 border-[var(--color-hairline)] hover:border-[var(--color-stone-grey)] px-5 py-4 transition-all duration-200 hover:shadow-sm">
          <div class="flex items-center justify-between gap-3">
            <div class="min-w-0">
              <div class="font-semibold text-[var(--color-graphite)]">Book on Airbnb</div>
              <div class="text-sm text-[var(--color-stone-grey)] mt-0.5">AirCover protection, platform support</div>
            </div>
          </div>
        </a>
        <p class="text-xs text-[var(--color-stone-grey)] text-center px-4">
          Direct is cheaper and personal. Airbnb offers AirCover mediation. Choose what works for you.
        </p>
      </div>
    </section>

    <!-- Imagery & surfaces -->
    <section>
      <h2 class="text-2xl font-medium mb-1">Imagery & surfaces</h2>
      <p class="text-sm text-[var(--color-stone-grey)] mb-6">Real photos, readable text over them, and a light page surface throughout.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
        <div class="rounded-xl border border-[var(--color-hairline)] p-4">
          <span class="block font-semibold mb-1">Real photos only</span>
          <span class="text-[var(--color-stone-grey)]">Never stock, not even temporarily. A styled placeholder with the correct aspect ratio (see the homepage "Meet your hosts" photo) is fine while a real photo is pending.</span>
        </div>
        <div class="rounded-xl border border-[var(--color-hairline)] p-4">
          <span class="block font-semibold mb-1">Hero text readability</span>
          <span class="text-[var(--color-stone-grey)]">A gradient scrim (<code>.gradient-scrim</code>) behind hero text, never a highlight box. Badges over photos are near-opaque pill chips (see Badges), not translucent glass, translucent fills lose to unpredictable photo content.</span>
        </div>
        <div class="rounded-xl border border-[var(--color-hairline)] p-4">
          <span class="block font-semibold mb-1">Dark surfaces: bands, not pages</span>
          <span class="text-[var(--color-stone-grey)]">Dark section bands using <code>schist-ink</code> are allowed (see the hot tub section, ~10% of the page) and used deliberately for contrast/rhythm. A full dark page surface is not, the site is light-mode only (TV mode is the one exception, and it isn't public). Low-contrast text over photos is never acceptable either way.</span>
        </div>
        <div class="rounded-xl border border-[var(--color-hairline)] p-4">
          <span class="block font-semibold mb-1">Badges are pill chips</span>
          <span class="text-[var(--color-stone-grey)]">Near-opaque white fill, colour-tinted border and text. Never a low-opacity colour tint on its own, it disappears over photos (see Color notes on gold contrast).</span>
        </div>
      </div>
    </section>

    <!-- Cards -->
    <section>
      <h2 class="text-2xl font-medium mb-1">Cards & panels</h2>
      <p class="text-sm text-[var(--color-stone-grey)] mb-6">Two nesting depths: outer panel <code>rounded-2xl border p-6</code>, inner tile <code>rounded-xl border p-3</code>.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="rounded-2xl border border-[var(--color-hairline)] bg-white p-6">
          <h3 class="text-lg font-medium mb-3">Outer panel</h3>
          <div class="grid grid-cols-2 gap-3">
            <div class="rounded-xl border border-[var(--color-hairline)] p-3">
              <span class="block text-sm font-semibold">Inner tile</span>
              <span class="block text-sm text-[var(--color-stone-grey)] mt-0.5">Detail row</span>
            </div>
            <div class="rounded-xl border border-[var(--color-hairline)] p-3">
              <span class="block text-sm font-semibold">Inner tile</span>
              <span class="block text-sm text-[var(--color-stone-grey)] mt-0.5">Detail row</span>
            </div>
          </div>
        </div>
        <figure class="rounded-2xl border border-[var(--color-hairline)] bg-white p-5">
          <div class="text-[var(--color-sun-gold-dark)] text-sm mb-2" aria-hidden="true">★★★★★</div>
          <blockquote class="text-sm leading-relaxed text-[var(--color-stone-grey)]">"Review card: quote text sits here, warm and specific."</blockquote>
          <figcaption class="mt-3 text-xs font-semibold text-[var(--color-graphite)]">Guest name · Location · Date</figcaption>
        </figure>
      </div>
    </section>

    <!-- Amenity chips -->
    <section>
      <h2 class="text-2xl font-medium mb-1">Amenity chips</h2>
      <p class="text-sm text-[var(--color-stone-grey)] mb-6">Icon + label, from <code>AmenityGrid.astro</code>.</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 max-w-lg">
        <div class="flex items-center gap-2 rounded-lg bg-[var(--color-hairline)]/50 px-3 py-2.5">
          <span class="text-lg flex-shrink-0" aria-hidden="true">🏔️</span>
          <span class="text-sm font-medium text-[var(--color-graphite)]">Mountain views</span>
        </div>
        <div class="flex items-center gap-2 rounded-lg bg-[var(--color-hairline)]/50 px-3 py-2.5">
          <span class="text-lg flex-shrink-0" aria-hidden="true">🚪</span>
          <span class="text-sm font-medium text-[var(--color-graphite)]">Own entrance</span>
        </div>
        <div class="flex items-center gap-2 rounded-lg bg-[var(--color-hairline)]/50 px-3 py-2.5">
          <span class="text-lg flex-shrink-0" aria-hidden="true">📶</span>
          <span class="text-sm font-medium text-[var(--color-graphite)]">WiFi</span>
        </div>
      </div>
    </section>

    <!-- Section header pattern -->
    <section>
      <h2 class="text-2xl font-medium mb-1">Section header pattern</h2>
      <p class="text-sm text-[var(--color-stone-grey)] mb-6">Centered kicker-free heading + one-line supporting copy, used to open most homepage sections.</p>
      <div class="rounded-xl border border-[var(--color-hairline)] p-8">
        <div class="max-w-2xl mx-auto text-center">
          <h2 class="text-3xl font-medium mb-4">Section title</h2>
          <p class="text-[var(--color-stone-grey)] max-w-xl mx-auto">One line of supporting copy, centered, in stone-grey.</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
