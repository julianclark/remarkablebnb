---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideEntry from '../../components/GuideEntry.astro';
import { getEntry, getCollection } from 'astro:content';

export const prerender = true;

const guide = await getEntry('guides', 'eat-and-drink');
const sections = (await getCollection('guideSections'))
  .filter((s) => s.data.guide === 'eat-and-drink')
  .sort((a, b) => a.data.order - b.data.order)
  .map((s) => s.data);
---

<BaseLayout
  title={guide!.data.seoTitle}
  description={guide!.data.seoDescription}
  noindex={guide!.data.draft}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    {guide!.data.draft && (
      <p class="badge badge-gold mb-6">Draft, awaiting host edit and sign-off</p>
    )}

    <nav class="mb-6 text-sm text-[var(--color-stone-grey)]">
      <a href="/" class="hover:text-[var(--color-ember)] transition-colors">Home</a>
      <span class="mx-2">›</span>
      <span class="text-[var(--color-graphite)]">{guide!.data.title}</span>
    </nav>

    <span class="text-4xl" aria-hidden="true">{guide!.data.icon}</span>
    <h1 class="text-4xl sm:text-5xl font-medium mt-4 mb-4">{guide!.data.title}</h1>
    {guide!.data.tagline && (
      <p class="text-lg font-serif italic text-[var(--color-ember)] leading-relaxed mb-4">{guide!.data.tagline}</p>
    )}

    <p class="text-sm text-[var(--color-stone-grey)] mb-8">
      Looking for things to do instead? See <a href="/guides/things-to-do" class="text-[var(--color-ember)] font-medium hover:underline">Things to do near The Remarkables</a>.
    </p>

    <div class="space-y-12">
      {sections.map((section) => (
        <section>
          <h2 class="text-2xl font-medium mb-2">{section.title}</h2>
          {section.intro && <p class="text-sm text-[var(--color-stone-grey)] mb-4">{section.intro}</p>}
          <div class="space-y-3">
            {section.entries.map((e) => (
              <GuideEntry name={e.name} tier={e.tier} meta={e.meta} note={e.note} website={e.website} />
            ))}
          </div>
        </section>
      ))}

      {guide!.data.extraBoxTitle && (
        <section class="rounded-xl border border-[var(--color-hairline)] bg-[var(--color-fill)] p-5">
          <div class="flex flex-wrap items-center gap-2 mb-1">
            <h3 class="text-lg font-medium">{guide!.data.extraBoxTitle}</h3>
            {guide!.data.extraBoxLink && (
              <a
                href={guide!.data.extraBoxLink.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-xs bg-[var(--color-ember)]/10 text-[var(--color-ember)] font-medium rounded-full px-2.5 py-1 hover:bg-[var(--color-ember)]/20 transition-colors"
              >
                {guide!.data.extraBoxLink.label} <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
          <p class="text-sm text-[var(--color-stone-grey)] leading-relaxed">{guide!.data.extraBoxText}</p>
        </section>
      )}
    </div>

    {guide!.data.askUsText && (
      <div class="mt-12 pt-8 border-t border-[var(--color-hairline)]">
        <h2 class="text-2xl font-medium mb-2">Ask us</h2>
        <p class="text-[var(--color-stone-grey)] leading-relaxed">
          {guide!.data.askUsText}
          {' '}<a href="/contact" class="text-[var(--color-ember)] font-semibold hover:underline">Get in touch</a>.
        </p>
      </div>
    )}

    <div class="mt-12 pt-8 border-t border-[var(--color-hairline)] flex flex-wrap items-center justify-between gap-4">
      <a href="/" class="inline-flex items-center gap-2 text-[var(--color-ember)] font-semibold hover:underline">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        Back to home
      </a>
      <a href="/guides/things-to-do" class="inline-flex items-center gap-2 text-[var(--color-ember)] font-semibold hover:underline">
        Things to do near The Remarkables
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </div>
</BaseLayout>
