---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with Holly and Julian to enquire about direct bookings at Remarkable BnB."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="text-center mb-12">
      <span class="badge badge-ember mb-3">Enquiries & Direct Bookings</span>
      <h1 class="text-4xl sm:text-5xl font-medium mb-4">Contact Holly & Julian</h1>
      <p class="text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] max-w-xl mx-auto">
        Have questions about the stays, availability, or planning your trip? Send us a message and we'll get right back to you.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Contact Info -->
      <div class="md:col-span-1 space-y-6">
        <div class="rounded-xl border border-[var(--color-hairline)] dark:border-[var(--color-stone-grey)] p-6 bg-white dark:bg-[var(--color-schist-ink)]">
          <h2 class="font-sans text-sm font-semibold uppercase tracking-widest text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] mb-4">Direct Contact</h2>
          <div class="space-y-4">
            <div>
              <p class="text-xs text-[var(--color-stone-grey)] dark:text-[var(--color-stone)]">Your Hosts</p>
              <p class="text-sm font-medium">Holly & Julian</p>
            </div>
            <div>
              <p class="text-xs text-[var(--color-stone-grey)] dark:text-[var(--color-stone)]">Location</p>
              <p class="text-sm font-medium">Hanley's Farm, Queenstown, NZ</p>
            </div>
            <div>
              <p class="text-xs text-[var(--color-stone-grey)] dark:text-[var(--color-stone)]">Email Enquiries</p>
              <!-- Placeholder for email as per TODO -->
              <p class="text-sm font-medium text-[var(--color-ember)]">stay@remarkablebnb.nz</p>
            </div>
          </div>
        </div>

        <div class="rounded-xl bg-[var(--color-hairline)]/40 p-6 text-sm">
          <h3 class="text-lg font-medium mb-2">💡 Booking direct</h3>
          <p class="text-[var(--color-stone-grey)] leading-relaxed">10% off Airbnb rates, no platform fees. <a href="/#why-book-direct" class="text-[var(--color-ember)] font-medium hover:underline">See the full comparison</a>.</p>
        </div>

        <div class="rounded-xl border border-[var(--color-hairline)] dark:border-[var(--color-stone-grey)] p-6 bg-white dark:bg-[var(--color-schist-ink)]">
          <h3 class="text-lg font-medium mb-3">How direct booking works</h3>
          <ol class="space-y-2 text-sm text-[var(--color-stone-grey)] list-decimal pl-4 marker:font-semibold marker:text-[var(--color-ember)]">
            <li>Send your preferred dates.</li>
            <li>We confirm availability and the exact total.</li>
            <li>We send secure payment details and your booking confirmation.</li>
          </ol>
          <p class="text-xs text-[var(--color-stone-grey)] mt-4">
            Read the full <a href="/terms" class="text-[var(--color-ember)] font-medium hover:underline">booking terms</a>, including cancellations, payment timing and house policies.
          </p>
        </div>
      </div>

      <!-- Enquiry Form -->
      <div class="md:col-span-2">
        <div id="enquiry-form"></div>
        <div
          class="hidden rounded-xl border border-[var(--color-forest)]/40 bg-[var(--color-forest)]/10 p-4 mb-4 text-sm"
          id="enquiry-success"
          role="status"
        >
          <strong>Thanks, your enquiry is on its way.</strong> We'll get back to you soon. For anything urgent, email us at <a class="text-[var(--color-ember)] underline" href="mailto:stay@remarkablebnb.nz">stay@remarkablebnb.nz</a>.
        </div>
        <div
          class="hidden rounded-xl border border-[var(--color-sun-gold)]/40 bg-[var(--color-sun-gold)]/10 p-4 mb-4 text-sm"
          id="enquiry-error"
          role="alert"
        >
          Sorry, something went wrong sending that. Please email us directly at <a class="text-[var(--color-ember)] underline" href="mailto:stay@remarkablebnb.nz">stay@remarkablebnb.nz</a>.
        </div>

        <form
          class="space-y-4 rounded-xl border border-[var(--color-hairline)] dark:border-[var(--color-stone-grey)] p-6 sm:p-8 bg-white dark:bg-[var(--color-schist-ink)]"
          id="enquiry-form-el"
          method="POST"
          action="/api/enquiry"
        >
          <h2 class="text-lg font-medium mb-4">Send an Enquiry</h2>

          <!-- Honeypot: hidden from users, catches bots -->
          <div class="hidden" aria-hidden="true">
            <label for="company">Company (leave blank)</label>
            <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
          </div>

          <!-- Populated by JS from calendar deep-links (?checkin=&checkout=) so
               the enquiry email can carry a price estimate. Empty for
               free-text date entries; the email simply omits the estimate. -->
          <input type="hidden" id="checkin" name="checkin" value="" />
          <input type="hidden" id="checkout" name="checkout" value="" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="name" class="block text-xs font-semibold uppercase tracking-widest text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] mb-1">Your Name</label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                required 
                class="w-full min-w-0 box-border font-sans rounded-lg border border-[var(--color-hairline)] px-3 py-2 text-sm bg-white text-[var(--color-graphite)] placeholder:text-[var(--color-stone-grey)]/70 focus:ring-1 focus:ring-[var(--color-ember)] focus:border-[var(--color-ember)] focus:outline-none"
              />
            </div>
            <div>
              <label for="email" class="block text-xs font-semibold uppercase tracking-widest text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] mb-1">Email Address</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                class="w-full min-w-0 box-border font-sans rounded-lg border border-[var(--color-hairline)] px-3 py-2 text-sm bg-white text-[var(--color-graphite)] placeholder:text-[var(--color-stone-grey)]/70 focus:ring-1 focus:ring-[var(--color-ember)] focus:border-[var(--color-ember)] focus:outline-none"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="stay" class="block text-xs font-semibold uppercase tracking-widest text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] mb-1">Which Stay?</label>
              <select 
                id="stay" 
                name="stay" 
                class="w-full min-w-0 box-border font-sans rounded-lg border border-[var(--color-hairline)] px-3 py-2 text-sm bg-white text-[var(--color-graphite)] placeholder:text-[var(--color-stone-grey)]/70 focus:ring-1 focus:ring-[var(--color-ember)] focus:border-[var(--color-ember)] focus:outline-none"
              >
                <option value="unit">Two Bedroom Unit</option>
                <option value="room">Guest Room</option>
                <option value="general">General Enquiry</option>
              </select>
            </div>
            <div>
              <label for="dates" class="block text-xs font-semibold uppercase tracking-widest text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] mb-1">Proposed Dates</label>
              <input 
                type="text" 
                id="dates" 
                name="dates" 
                placeholder="e.g. 15-20 Aug"
                class="w-full min-w-0 box-border font-sans rounded-lg border border-[var(--color-hairline)] px-3 py-2 text-sm bg-white text-[var(--color-graphite)] placeholder:text-[var(--color-stone-grey)]/70 focus:ring-1 focus:ring-[var(--color-ember)] focus:border-[var(--color-ember)] focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="message" class="block text-xs font-semibold uppercase tracking-widest text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] mb-1">Message</label>
            <textarea 
              id="message" 
              name="message" 
              rows="4" 
              required 
              placeholder="Tell us about your plans, guest numbers, or any specific questions..."
              class="w-full min-w-0 box-border font-sans rounded-lg border border-[var(--color-hairline)] px-3 py-2 text-sm bg-white text-[var(--color-graphite)] placeholder:text-[var(--color-stone-grey)]/70 focus:ring-1 focus:ring-[var(--color-ember)] focus:border-[var(--color-ember)] focus:outline-none"
            ></textarea>
          </div>

          <div class="pt-2">
            <button
              type="submit"
              id="enquiry-submit"
              class="w-full box-border font-sans rounded-lg bg-[var(--color-ember)] hover:bg-[var(--color-link-hover)] text-white px-4 py-3 font-semibold text-sm transition-colors cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
            >
              Submit Enquiry
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    function initEnquiry() {
      const form = document.getElementById('enquiry-form-el') as HTMLFormElement | null;
      if (!form) return;

      const success = document.getElementById('enquiry-success');
      const errorBox = document.getElementById('enquiry-error');
      const submit = document.getElementById('enquiry-submit') as HTMLButtonElement | null;
      const params = new URLSearchParams(location.search);

      const fmt = (iso: string) =>
        new Date(iso + 'T00:00:00Z').toLocaleDateString('en-NZ', { day: 'numeric', month: 'short', timeZone: 'UTC' });

      // Prefill from calendar deep-links (?stay=&date= or ?checkin=&checkout=)
      const stayParam = params.get('stay');
      if (stayParam) {
        const sel = form.elements.namedItem('stay') as HTMLSelectElement | null;
        if (sel && Array.from(sel.options).some((o) => o.value === stayParam)) sel.value = stayParam;
      }
      const checkin = params.get('checkin');
      const checkout = params.get('checkout');
      const single = params.get('date');
      const datesInput = form.elements.namedItem('dates') as HTMLInputElement | null;
      const checkinField = form.elements.namedItem('checkin') as HTMLInputElement | null;
      const checkoutField = form.elements.namedItem('checkout') as HTMLInputElement | null;
      if (datesInput) {
        if (checkin && checkout) {
          datesInput.value = `${fmt(checkin)} – ${fmt(checkout)}`;
          if (checkinField) checkinField.value = checkin;
          if (checkoutField) checkoutField.value = checkout;
        } else if (single) {
          datesInput.value = fmt(single);
        }
        // If the guest edits the prefilled dates by hand, the ISO hidden
        // fields no longer describe what they typed, clear them so the
        // enquiry email doesn't carry a stale estimate.
        datesInput.addEventListener('input', () => {
          if (checkinField) checkinField.value = '';
          if (checkoutField) checkoutField.value = '';
        });
      }

      // Show status banner if we came back from a no-JS POST redirect
      if (params.get('sent')) success?.classList.remove('hidden');
      if (params.get('error')) errorBox?.classList.remove('hidden');

      // Progressive enhancement: submit via fetch, no page reload
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        success?.classList.add('hidden');
        errorBox?.classList.add('hidden');
        if (submit) { submit.disabled = true; submit.textContent = 'Sending…'; }

        try {
          const res = await fetch('/api/enquiry', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(Object.fromEntries(new FormData(form) as any)),
          });
          const data = await res.json().catch(() => ({ ok: res.ok }));
          if (data.ok) {
            form.reset();
            success?.classList.remove('hidden');
            success?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } else {
            errorBox?.classList.remove('hidden');
          }
        } catch {
          errorBox?.classList.remove('hidden');
        } finally {
          if (submit) { submit.disabled = false; submit.textContent = 'Submit Enquiry'; }
        }
      });
    }

    initEnquiry();
    document.addEventListener('astro:page-load', initEnquiry);
  </script>
</BaseLayout>
