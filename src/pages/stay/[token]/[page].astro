---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import { getSiteFacts } from '../../../lib/site-facts';
import { env } from 'cloudflare:workers';

export const prerender = false;

const { token, page } = Astro.params;
const allowedPages = ['check-in', 'manual', 'rules', 'extras', 'checkout'];

if (!token || !page || !allowedPages.includes(page)) {
  return new Response("Not Found", { status: 404 });
}

// 1. Fetch stay data from D1 or fallback to Mock stay for local development
let stay = null;
const db = env.DB;

if (db) {
  try {
    const { results } = await db.prepare("SELECT * FROM stays WHERE token = ?").bind(token).all();
    if (results && results.length > 0) {
      const row = results[0];
      stay = {
        token: row.token,
        room: row.room,
        source: row.source,
        checkIn: row.check_in,
        checkOut: row.check_out,
        hotTubOffered: Boolean(row.hot_tub_offered)
      };
    }
  } catch (err) {
    console.error("D1 database query failed: ", err);
  }
}

// Dev fallback for previewing
if (!stay && token === 'demo') {
  stay = {
    token: 'demo',
    room: 'two-bedroom-unit',
    source: 'airbnb',
    checkIn: new Date(Date.now() - 2 * 24 * 60 * 60 * 1000).toISOString().split('T')[0], // Started 2 days ago
    checkOut: new Date(Date.now() + 3 * 24 * 60 * 60 * 1000).toISOString().split('T')[0], // Ends in 3 days
    hotTubOffered: true
  };
}

if (!stay) {
  return new Response("Invalid stay token", { status: 404 });
}

// 2. Validate checking window (valid 3 days before check-in to 7 days after checkout)
const now = new Date();
const checkInDate = new Date(stay.checkIn);
const checkOutDate = new Date(stay.checkOut);

const accessStart = new Date(checkInDate);
accessStart.setDate(accessStart.getDate() - 3);
accessStart.setHours(0, 0, 0, 0);

const accessEnd = new Date(checkOutDate);
accessEnd.setDate(accessEnd.getDate() + 7);
accessEnd.setHours(23, 59, 59, 999);

const tooEarly = now < accessStart;
const tooLate = now > accessEnd;

if (tooEarly) {
  // If accessing too early, return a 404 to avoid leaking valid token presence
  return new Response("Not Found", { status: 404 });
}

if (tooLate) {
  // If stay has ended, display a polite 410 Gone page
  Astro.response.status = 410;
}

// Map slug to content collection entry
const collectionPageMap: Record<string, string> = {
  'check-in': 'check-in',
  'manual': 'house-manual',
  'rules': 'rules',
  'checkout': 'checkout'
};

// 3. Render content
let pageTitle = '';
let pageIcon = '';
let Content;

if (page !== 'extras') {
  const collectionKey = collectionPageMap[page];
  const entry = await getEntry('manual', collectionKey);
  if (entry) {
    const rendered = await render(entry);
    Content = rendered.Content;
    pageTitle = entry.data.title;
    pageIcon = entry.data.icon;
  }
} else {
  // "Extras" wraps host-written copy in an interactive request/Stripe flow.
  pageTitle = "Paid Extras";
  pageIcon = "🛁";
}

// Guest-hub copy blocks (extras offer, both checkout variants, the expired
// page) live in src/content/guest/*.md so host-voice prose is edited as
// markdown rather than inline in this template.
const extrasCopy = (await getEntry('guestCopy', 'extras'))!;
const { Content: ExtrasContent } = await render(extrasCopy);

const checkoutCopy = (await getEntry(
  'guestCopy',
  stay.source === 'airbnb' ? 'checkout-airbnb' : 'checkout-direct'
))!;
const { Content: CheckoutContent } = await render(checkoutCopy);

const endedCopy = (await getEntry('guestCopy', 'stay-ended'))!;
const { Content: EndedContent } = await render(endedCopy);

const facts = await getSiteFacts();

// Shared prose styling for the small guest-hub copy blocks.
const guestProse = 'prose prose-slate dark:prose-invert prose-sm max-w-none prose-p:text-[var(--color-stone-grey)] dark:prose-p:text-[var(--color-stone)] prose-p:leading-relaxed prose-strong:text-[var(--color-graphite)] dark:prose-strong:text-white';
---

{tooLate ? (
  <BaseLayout title="Stay Ended" description="This stay has ended." noindex={true}>
    <div class="max-w-md mx-auto px-4 py-20 text-center">
      <div class="text-6xl mb-6">{endedCopy.data.icon}</div>
      <h1 class="text-2xl font-medium mb-4">{endedCopy.data.heading}</h1>
      <div class={`${guestProse} mb-6`}>
        <EndedContent />
      </div>
      <a href={endedCopy.data.ctaHref} class="inline-flex items-center gap-2 bg-[var(--color-ember)] hover:bg-[var(--color-link-hover)] text-white px-5 py-2.5 rounded-xl font-semibold text-sm transition-colors">
        {endedCopy.data.ctaLabel}
      </a>
    </div>
  </BaseLayout>
) : (
  <BaseLayout title={`${pageTitle}, Guest Hub`} description="Your personal stays hub for Remarkable BnB." noindex={true}>
    <!-- Guest navigation tabs -->
    <div class="sticky top-16 z-40 bg-[var(--color-snow)] border-b border-[var(--color-hairline)] dark:border-[var(--color-stone-grey)]">
      <div class="max-w-4xl mx-auto px-4">
        <div class="flex items-center gap-1 overflow-x-auto py-3 no-scrollbar scroll-smooth">
          <a
            href={`/stay/${token}/check-in`}
            class:list={[
              'flex-shrink-0 flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold uppercase tracking-widest transition-colors',
              page === 'check-in' 
                ? 'bg-[var(--color-ember)]/10 text-[var(--color-ember)]' 
                : 'text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] hover:bg-[var(--color-hairline)]/50 dark:hover:bg-[var(--color-stone-grey)]/30'
            ]}
          >
            🔑 Check-in
          </a>
          <a
            href={`/stay/${token}/manual`}
            class:list={[
              'flex-shrink-0 flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold uppercase tracking-widest transition-colors',
              page === 'manual' 
                ? 'bg-[var(--color-ember)]/10 text-[var(--color-ember)]' 
                : 'text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] hover:bg-[var(--color-hairline)]/50 dark:hover:bg-[var(--color-stone-grey)]/30'
            ]}
          >
            🏠 Manual
          </a>
          <a
            href={`/stay/${token}/rules`}
            class:list={[
              'flex-shrink-0 flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold uppercase tracking-widest transition-colors',
              page === 'rules' 
                ? 'bg-[var(--color-ember)]/10 text-[var(--color-ember)]' 
                : 'text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] hover:bg-[var(--color-hairline)]/50 dark:hover:bg-[var(--color-stone-grey)]/30'
            ]}
          >
            📋 Rules
          </a>
          
          {stay.hotTubOffered && (
            <a
              href={`/stay/${token}/extras`}
              class:list={[
                'flex-shrink-0 flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold uppercase tracking-widest transition-colors',
                page === 'extras' 
                  ? 'bg-[var(--color-ember)]/10 text-[var(--color-ember)]' 
                  : 'text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] hover:bg-[var(--color-hairline)]/50 dark:hover:bg-[var(--color-stone-grey)]/30'
              ]}
            >
              🛁 Extras
            </a>
          )}
          
          <a
            href={`/stay/${token}/checkout`}
            class:list={[
              'flex-shrink-0 flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold uppercase tracking-widest transition-colors',
              page === 'checkout' 
                ? 'bg-[var(--color-ember)]/10 text-[var(--color-ember)]' 
                : 'text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] hover:bg-[var(--color-hairline)]/50 dark:hover:bg-[var(--color-stone-grey)]/30'
            ]}
          >
            👋 Checkout
          </a>
        </div>
      </div>
    </div>

    <!-- Page Body -->
    <div class="max-w-3xl mx-auto px-4 py-8 sm:py-12">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-3xl" aria-hidden="true">{pageIcon}</span>
        <h1 class="text-3xl font-medium">{pageTitle}</h1>
      </div>

      <!-- Render dynamically generated extras page -->
      {page === 'extras' ? (
        <div class="space-y-6">
          <div class="rounded-2xl border-2 border-[var(--color-ember)] bg-[var(--color-ember)]/5 dark:bg-[var(--color-ember)]/10 p-6 sm:p-8">
            <h2 class="text-lg font-medium mb-3">{extrasCopy.data.heading}</h2>
            <div class={`${guestProse} mb-4`}>
              <ExtrasContent />
            </div>
            <p class="text-xs text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] mb-4">
              Up to {facts.hotTub.maxPeople} people, heated to {facts.hotTub.tempRange}. {facts.hotTub.rules}
            </p>

            <div class="space-y-3">
              <a
                href={extrasCopy.data.ctaHref}
                class="inline-flex justify-center items-center w-full rounded-xl bg-[var(--color-ember)] hover:bg-[var(--color-link-hover)] text-white px-5 py-3 font-semibold text-sm transition-colors text-center"
              >
                {extrasCopy.data.ctaLabel}
              </a>
              <p class="text-xs text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] text-center">
                {extrasCopy.data.ctaNote}
              </p>
            </div>
          </div>
        </div>
      ) : (
        <div class="prose prose-slate dark:prose-invert max-w-none prose-headings:font-medium prose-h2:text-xl prose-h2:mt-8 prose-h2:mb-4 prose-p:leading-relaxed prose-li:leading-relaxed">
          {Content && <Content />}
        </div>
      )}

      <!-- Adapt checkout page based on token source -->
      {page === 'checkout' && (
        <div class="mt-12 pt-8 border-t border-[var(--color-hairline)] dark:border-[var(--color-stone-grey)]">
          <div
            class:list={[
              'rounded-xl p-6',
              stay.source === 'airbnb'
                ? 'border border-[var(--color-hairline)] dark:border-[var(--color-stone-grey)] bg-white dark:bg-[var(--color-schist-ink)]'
                : 'border border-[var(--color-sun-gold)]/30 bg-[var(--color-sun-gold)]/5 dark:bg-[var(--color-sun-gold)]/10',
            ]}
          >
            <h3
              class:list={[
                'font-medium text-lg mb-2',
                stay.source !== 'airbnb' && 'text-[var(--color-sun-gold-dark)]',
              ]}
            >
              {checkoutCopy.data.heading}
            </h3>
            <div class={guestProse}>
              <CheckoutContent />
            </div>
            {stay.source === 'airbnb' && (
              <p class="text-sm font-semibold text-[var(--color-graphite)] dark:text-white mt-4">
                Save our details: <span class="text-[var(--color-ember)]">{facts.email}</span>
              </p>
            )}
          </div>
        </div>
      )}
    </div>
  </BaseLayout>
)}
