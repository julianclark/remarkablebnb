---
import BaseLayout from '../layouts/BaseLayout.astro';
import Review from '../components/Review.astro';
import WinterPanel from '../components/WinterPanel.astro';
import { Image } from 'astro:assets';
import { getCollection, getEntry, render } from 'astro:content';
import dogPhoto from '../assets/photos/guest-room/dogs.avif';
import hotTubPhoto from '../assets/photos/hot-tub/hot-tub-sunset.jpg';

export const prerender = true;

const stays = await getCollection('stays');
const faqs = (await getCollection('faqs')).sort((a, b) => a.data.order - b.data.order);

const hostsSection = await getEntry('homeSections', 'hosts');
const dogsSection = await getEntry('homeSections', 'dogs');
const { Content: HostsContent } = await render(hostsSection!);
const { Content: DogsContent } = await render(dogsSection!);
const homeProse = 'prose prose-slate max-w-none prose-headings:font-medium prose-p:text-lg prose-p:text-[var(--color-stone-grey)] prose-p:leading-relaxed prose-a:text-[var(--color-ember)] prose-a:font-medium prose-blockquote:not-italic prose-blockquote:font-normal prose-blockquote:border-l-0 prose-blockquote:border prose-blockquote:border-[var(--color-ember)]/30 prose-blockquote:bg-[var(--color-ember)]/5 prose-blockquote:rounded-xl prose-blockquote:px-4 prose-blockquote:py-3 prose-blockquote:text-sm prose-blockquote:text-[var(--color-stone-grey)] prose-strong:text-[var(--color-graphite)]';

const reviews = (await getCollection('reviews')).map((r) => r.data);
const reviewById = (id: string) => reviews.find((r) => r.id === id)!;
const totalReviews = stays.reduce((sum, s) => sum + (s.data.reviewCount ?? 0), 0);

// Rotating testimonial strip: lead with Riaz, cycle through strong picks.
const testimonialIds = ['bu-riaz', 'gr-amy', 'bu-sherry', 'bu-eleanor', 'gr-katie'];
const testimonials = testimonialIds.map(reviewById);

const segments = (await getCollection('segments')).sort((a, b) => a.data.order - b.data.order).map((s) => s.data);
const locationRows = (await getCollection('locationRows')).sort((a, b) => a.data.order - b.data.order).map((s) => s.data);
// Host tips: short, first-person, real. Placed alongside the distance facts,
// which stay unchanged (skiers and airport arrivals scan for those).
const hostTips = (await getCollection('hostTips')).sort((a, b) => a.data.order - b.data.order).map((s) => s.data);
const bookDirectExtras = (await getCollection('bookDirectExtras')).sort((a, b) => a.data.order - b.data.order).map((s) => s.data);

// Seasonal hero: swap src/content/home/hero.json (and the image at
// /public/images/hero.jpg) to re-theme by season. Winter: snow imagery + ski
// messaging. Summer: trails, sunsets, hot tub. Same layout and palette either way.
const hero = (await getEntry('hero', 'default'))!.data;

---

<BaseLayout title="Remarkable BnB" description="Accommodation at Holly and Julian's home in Hanley's Farm, Queenstown. Near The Remarkables ski field and Jack's Point. Book direct and save 10%.">

  <!-- Hero section -->
  <section class="hero-section relative h-[70vh] min-h-[500px] flex items-end overflow-hidden">
    <div class="absolute inset-0 bg-[var(--color-schist-ink)]">
      <img
        src={hero.image}
        alt={hero.imageAlt}
        class="w-full h-full object-cover opacity-70"
        loading="eager"
        decoding="async"
      />
    </div>
    <div class="absolute inset-0 gradient-scrim"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 sm:pb-16 w-full">
      <p class="text-sm font-medium text-[var(--color-cream)]/70 uppercase tracking-widest mb-3">{hero.kicker}</p>
      <h1 class="text-4xl sm:text-5xl font-medium text-[var(--color-cream)] mb-4 leading-tight !text-[var(--color-cream)]">
        {hero.heading}
      </h1>
      <p class="text-lg sm:text-xl text-[var(--color-cream)]/85 max-w-xl mb-6 leading-relaxed">
        {hero.subcopy}
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="#stays" class="no-underline inline-flex items-center gap-2 bg-white text-[var(--color-graphite)] font-semibold px-6 py-3 rounded-xl hover:bg-[var(--color-hairline)] transition-all duration-200 hover:shadow-lg" id="hero-cta-stays">
          View our stays
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
          </svg>
        </a>
        <a href="#hosts" class="no-underline inline-flex items-center gap-2 bg-[var(--color-schist-ink)]/60 backdrop-blur-sm text-[var(--color-cream)] border border-white/40 font-semibold px-6 py-3 rounded-xl hover:bg-[var(--color-schist-ink)]/80 transition-all duration-200" id="hero-cta-hosts">
          Meet your hosts 👋
        </a>
        <a href="#dogs" class="no-underline inline-flex items-center gap-2 bg-[var(--color-schist-ink)]/60 backdrop-blur-sm text-[var(--color-cream)] border border-white/40 font-semibold px-6 py-3 rounded-xl hover:bg-[var(--color-schist-ink)]/80 transition-all duration-200" id="hero-cta-dogs">
          Meet the dogs 🐾
        </a>
        <a href="/contact" class="no-underline inline-flex items-center gap-2 bg-[var(--color-schist-ink)]/60 backdrop-blur-sm text-[var(--color-cream)] border border-white/40 font-semibold px-6 py-3 rounded-xl hover:bg-[var(--color-schist-ink)]/80 transition-all duration-200" id="hero-cta-contact">
          Get in touch
        </a>
      </div>
    </div>
  </section>

  <!-- Compact section nav: hidden until the hero scrolls out of view, then
       sticks below the header so guests can jump between sections from
       anywhere on the page. Order matches the hero CTA row and homepage
       section order: Stays, Hosts, Dogs. -->
  <nav
    class="section-nav sticky top-16 z-40 -translate-y-full opacity-0 pointer-events-none transition-all duration-200 bg-white/95 backdrop-blur-sm border-b border-[var(--color-hairline)]"
    data-section-nav
    aria-label="Jump to section"
  >
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 py-2 overflow-x-auto">
        <a href="#stays" data-section-link="stays" class="no-underline flex-shrink-0 text-sm font-medium px-3 py-1.5 rounded-full text-[var(--color-stone-grey)] hover:text-[var(--color-graphite)] hover:bg-[var(--color-hairline)]/60 transition-colors">Stays</a>
        <a href="#hosts" data-section-link="hosts" class="no-underline flex-shrink-0 text-sm font-medium px-3 py-1.5 rounded-full text-[var(--color-stone-grey)] hover:text-[var(--color-graphite)] hover:bg-[var(--color-hairline)]/60 transition-colors">Hosts</a>
        <a href="#dogs" data-section-link="dogs" class="no-underline flex-shrink-0 text-sm font-medium px-3 py-1.5 rounded-full text-[var(--color-stone-grey)] hover:text-[var(--color-graphite)] hover:bg-[var(--color-hairline)]/60 transition-colors">Dogs</a>
        <a href="/contact" class="no-underline flex-shrink-0 text-sm font-medium px-3 py-1.5 rounded-full text-[var(--color-ember)] hover:bg-[var(--color-ember)]/10 transition-colors ml-auto">Get in touch</a>
      </div>
    </div>
  </nav>

  <!-- Social proof strip -->
  <section class="border-b border-[var(--color-hairline)] dark:border-[var(--color-stone-grey)] bg-[var(--color-snow)]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-4">
        <span class="font-semibold text-[var(--color-sun-gold-dark)]">★ 5.0</span>
        <span class="text-sm text-[var(--color-stone-grey)] dark:text-[var(--color-stone)]">across {totalReviews} Airbnb reviews</span>
        <span class="badge badge-gold">⭐ Guest Favourite</span>
        <span class="badge badge-ember">Top-rated on Airbnb</span>
      </div>
      <!-- Rotating testimonial (shows first without JS) -->
      <div data-testimonials aria-live="polite">
        {testimonials.map((t, i) => (
          <blockquote
            class:list={['testimonial text-sm italic text-[var(--color-stone-grey)] dark:text-[var(--color-stone)]', i !== 0 && 'hidden']}
            data-testimonial
          >
            “{t.quote}”
            <cite class="not-italic font-semibold text-xs block mt-1 text-[var(--color-graphite)] dark:text-[var(--color-cream)]">{[t.name, t.location].filter(Boolean).join(', ')}, {t.stay === 'two-bedroom-unit' ? 'Two Bedroom Unit' : 'Guest Room'}</cite>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- Stays -->
  <section id="stays" class="py-16 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-medium mb-4">Our stays</h2>
        <p class="text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] max-w-xl mx-auto">
          Two ways to stay at our home in Hanley's Farm, a private room inside the house, or your own self-contained unit.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {stays.map((stay) => (
          <a
            href={`/stays/${stay.data.slug}`}
            class="group card rounded-2xl overflow-hidden border border-[var(--color-hairline)] dark:border-[var(--color-stone-grey)] bg-white dark:bg-[var(--color-schist-ink)] hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
            id={`stay-card-${stay.data.slug}`}
          >
            <div class="relative h-56 sm:h-64 overflow-hidden bg-[var(--color-hairline)]">
              <img
                src={stay.data.heroImage}
                alt={stay.data.heroAlt}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute top-3 left-3 flex flex-wrap gap-2">
                {stay.data.guestFavourite && <span class="badge badge-gold">⭐ Guest Favourite</span>}
                {stay.data.topPercent && <span class="badge badge-ember">Top {stay.data.topPercent}%</span>}
              </div>
            </div>

            <div class="p-6">
              <h3 class="text-lg font-medium mb-1 group-hover:text-[var(--color-ember)] transition-colors">{stay.data.title}</h3>
              <p class="text-sm text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] mb-4">{stay.data.tagline}</p>

              {stay.data.facts.length > 0 && (
                <ul class="flex flex-wrap gap-2 mb-1">
                  {stay.data.facts.map((fact) => (
                    <li class="text-xs bg-[var(--color-fill)] dark:bg-[var(--color-stone-grey)]/30 text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] rounded-full px-2.5 py-1">{fact}</li>
                  ))}
                </ul>
              )}

              {stay.data.rating && (
                <div class="mt-3 flex items-center gap-1 text-sm">
                  <span class="text-[var(--color-sun-gold-dark)]">★ {stay.data.rating}</span>
                  <span class="text-[var(--color-stone-grey)] dark:text-[var(--color-stone)]">
                    · {stay.data.reviewCount} reviews on Airbnb
                  </span>
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Meet your hosts -->
  <section id="hosts" class="py-16 sm:py-20 bg-[var(--color-hairline)]/30 dark:bg-[var(--color-stone-grey)]/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <!-- Photo placeholder: real candid shot of Holly & Julian with Rocket and Luna
             on the deck, Remarkables behind, to replace this before launch. -->
        <div class="order-2 lg:order-1">
          <div class="aspect-[4/5] rounded-2xl border-2 border-dashed border-[var(--color-hairline)] dark:border-[var(--color-stone-grey)] bg-[var(--color-hairline)]/50 dark:bg-[var(--color-stone-grey)]/20 flex flex-col items-center justify-center text-center p-8">
            <span class="text-4xl mb-3" aria-hidden="true">📷</span>
            <p class="text-sm font-semibold text-[var(--color-stone-grey)] dark:text-[var(--color-stone)]">Photo coming soon</p>
            <p class="text-xs text-[var(--color-stone-grey)]/70 dark:text-[var(--color-stone)]/70 mt-1 max-w-[16rem]">{hostsSection!.data.photoAlt}</p>
          </div>
        </div>

        <div class="order-1 lg:order-2">
          <span class="badge badge-forest mb-3">{hostsSection!.data.badge}</span>
          <h2 class="text-3xl font-medium mb-4">{hostsSection!.data.heading}</h2>
          <div class={homeProse}>
            <HostsContent />
          </div>
          {hostsSection!.data.signoffLine && (
            <p class="italic text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] mt-6 mb-6 pt-4 border-t border-[var(--color-hairline)] dark:border-[var(--color-stone-grey)]">
              {hostsSection!.data.signoffLine}<br />{hostsSection!.data.signoffNames}
            </p>
          )}
          <a href="/contact" class="inline-flex items-center gap-2 text-[var(--color-ember)] font-semibold hover:underline" id="about-contact-link">
            Get in touch with us
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Meet Rocket & Luna -->
  <section id="dogs" class="py-16 sm:py-20 bg-[var(--color-hairline)]/30 dark:bg-[var(--color-stone-grey)]/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div class="rounded-2xl overflow-hidden shadow-sm order-2 lg:order-1">
          <Image src={dogPhoto} alt={dogsSection!.data.photoAlt} widths={[480, 768, 1024]} sizes="(max-width: 1024px) 100vw, 560px" class="w-full h-full object-cover" />
        </div>
        <div class="order-1 lg:order-2">
          <span class="badge badge-forest mb-3">{dogsSection!.data.badge}</span>
          <h2 class="text-3xl font-medium mb-4">{dogsSection!.data.heading}</h2>
          <div class={homeProse}>
            <DogsContent />
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-10">
        {[reviewById('gr-amy'), reviewById('gr-katie')].map((r) => (
          <Review quote={r.quote} name={r.name} date={r.date} location={r.location} />
        ))}
      </div>
    </div>
  </section>

  <!-- Wood-fired hot tub (navy feature band) -->
  <section class="py-16 sm:py-20 bg-[var(--color-schist-ink)] text-[var(--color-cream)]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div class="rounded-2xl overflow-hidden shadow-xl order-2 lg:order-1">
          <Image src={hotTubPhoto} alt="Our wood-fired hot tub on the deck at dusk, with alpenglow on The Remarkables" widths={[480, 768, 1080]} sizes="(max-width: 1024px) 100vw, 560px" class="w-full h-auto object-cover" />
        </div>
        <div class="order-1 lg:order-2">
          <span class="badge badge-gold mb-3">🔥 Add-on</span>
          <h2 class="text-3xl sm:text-4xl font-medium mb-4 !text-[var(--color-cream)]">Wood-fired hot tub, under the Southern sky</h2>
          <p class="text-lg text-[var(--color-cream)]/85 leading-relaxed mb-4">
            Book an evening in our wood-fired hot tub under the Southern sky. We light the fire, manage the temperature, and leave the stars to do the rest. Sessions run about 1.5 hours, and the 9pm slot catches the sunset fading over The Remarkables.
          </p>
          <p class="text-[var(--color-cream)]/70 text-sm leading-relaxed mb-6">
            Up to 4 people. Bookable as an add-on when you book direct, with pricing on request. Swimwear required; please shower before use. Add-ons like this are easiest to arrange when you book directly with us.
          </p>
          <a href="/contact" class="inline-flex items-center gap-2 bg-white text-[var(--color-graphite)] font-semibold px-6 py-3 rounded-xl hover:bg-[var(--color-hairline)] transition-all duration-200">
            Ask about the hot tub
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-10">
        {[reviewById('bu-rita'), reviewById('gr-wai-ching')].map((r) => (
          <figure class="rounded-2xl bg-white/10 backdrop-blur-sm border border-white/15 p-5">
            <div class="text-[var(--color-sun-gold)] text-sm mb-2" aria-hidden="true">★★★★★</div>
            {r.original && <blockquote lang="und" class="text-sm leading-relaxed mb-2 text-[var(--color-cream)]/90">“{r.original}”</blockquote>}
            <blockquote class:list={['text-sm leading-relaxed text-[var(--color-cream)]/80', r.original && 'italic']}>{r.original ? r.quote : `“${r.quote}”`}</blockquote>
            <figcaption class="mt-3 text-xs font-semibold text-[var(--color-cream)]">{[r.name, r.location, r.date].filter(Boolean).join(' · ')}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Who we're great for -->
  <section class="py-16 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-medium mb-4">Who we're great for</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {segments.map((s) => (
          <div class="rounded-2xl border border-[var(--color-hairline)] dark:border-[var(--color-stone-grey)] p-6 flex flex-col">
            <div class="text-3xl mb-3" aria-hidden="true">{s.icon}</div>
            <h3 class="text-lg font-medium mb-2">{s.title}</h3>
            <p class="text-sm text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] leading-relaxed">{s.copy}</p>
            {s.reviewId && (
              <blockquote class="mt-4 pt-4 border-t border-[var(--color-hairline)] dark:border-[var(--color-stone-grey)] text-xs italic text-[var(--color-stone-grey)] dark:text-[var(--color-stone)]">
                “{reviewById(s.reviewId).quote}”
                <cite class="not-italic font-semibold block mt-1">{reviewById(s.reviewId).name}</cite>
              </blockquote>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Location & getting around -->
  <section class="py-16 sm:py-20 bg-[var(--color-hairline)]/30 dark:bg-[var(--color-stone-grey)]/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-medium mb-4">Location & getting around</h2>
        <p class="text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] max-w-xl mx-auto">
          We're in Hanley's Farm, at the Jack's Point end, under The Remarkables.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {locationRows.map((row) => (
          <div class="flex items-start gap-3 rounded-xl border border-[var(--color-hairline)] dark:border-[var(--color-stone-grey)] bg-white dark:bg-[var(--color-schist-ink)] p-4">
            <span class="text-xl mt-0.5" aria-hidden="true">{row.icon}</span>
            <div>
              <div class="font-semibold text-sm">{row.label}</div>
              <div class="text-sm text-[var(--color-stone-grey)] dark:text-[var(--color-stone)]">{row.detail}</div>
            </div>
          </div>
        ))}
      </div>
      <p class="text-center text-sm text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] mt-8">
        Full address, parking and arrival directions are sent as soon as you book.
      </p>

      <!-- Host tips -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-8">
        {hostTips.map((tip) => (
          <div class="rounded-xl border border-[var(--color-sun-gold)]/30 bg-[var(--color-sun-gold)]/5 p-4">
            <div class="flex items-center gap-2 mb-1.5">
              <span aria-hidden="true">{tip.icon}</span>
              <span class="text-xs font-semibold uppercase tracking-widest text-[var(--color-sun-gold-dark)]">Host tip · {tip.title}</span>
            </div>
            <p class="text-sm text-[var(--color-stone-grey)] leading-relaxed">{tip.copy}</p>
          </div>
        ))}
      </div>

      <!-- Winter conditions data panel -->
      <WinterPanel />
    </div>
  </section>

  <!-- Why Book Direct -->
  <section class="py-16 sm:py-20 bg-gradient-to-b from-[var(--color-ember)]/5 to-transparent dark:from-[var(--color-ember)]/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-10">
        <span class="badge badge-ember mb-3">Save when you book direct</span>
        <h2 class="text-3xl font-medium mb-4">Why book with us?</h2>
        <p class="text-[var(--color-stone-grey)] dark:text-[var(--color-stone)]">
          We're on Airbnb too, but booking directly means a better deal and a more personal experience.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-2xl mx-auto mb-10">
        <div class="rounded-xl border border-[var(--color-hairline)] dark:border-[var(--color-stone-grey)] p-6 text-center">
          <div class="text-sm font-medium text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] uppercase tracking-widest mb-2">Airbnb</div>
          <div class="text-2xl font-bold mb-1">Full rate</div>
          <div class="text-sm text-[var(--color-stone-grey)] dark:text-[var(--color-stone)]">+ Airbnb service fee</div>
          <div class="text-xs text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] mt-3">AirCover protection included</div>
        </div>

        <div class="rounded-xl border-2 border-[var(--color-ember)] bg-[var(--color-ember)]/5 dark:bg-[var(--color-ember)]/10 pt-8 pb-6 px-6 text-center relative">
          <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 z-10">
            <span class="inline-flex items-center rounded-full bg-[var(--color-ember)] text-[var(--color-cream)] text-xs font-semibold uppercase tracking-widest px-3 py-1 shadow-sm">Best value</span>
          </div>
          <div class="text-sm font-medium text-[var(--color-ember)] uppercase tracking-widest mb-2">Book Direct</div>
          <div class="text-2xl font-bold mb-1">10% off</div>
          <div class="text-sm text-[var(--color-stone-grey)] dark:text-[var(--color-stone)]">No service fees</div>
          <div class="text-xs text-[var(--color-ember)] font-medium mt-3">Deal with Holly & Julian directly</div>
        </div>
      </div>

      <div class="max-w-2xl mx-auto">
        <p class="text-center text-sm font-semibold uppercase tracking-widest text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] mb-4">And the personal extras, only easy direct</p>
        <ul class="space-y-2">
          {bookDirectExtras.map((extra) => (
            <li class="flex items-start gap-3 text-sm text-[var(--color-stone-grey)] dark:text-[var(--color-stone)]">
              <span aria-hidden="true">{extra.icon}</span>
              <span>{extra.text}</span>
            </li>
          ))}
        </ul>
        <p class="text-sm text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] mt-4">
          Regular work trips to Queenstown? <a href="/contact" class="text-[var(--color-ember)] font-medium hover:underline">Talk to us about direct rates for repeat stays.</a>
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 sm:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-medium mb-4">Before you book</h2>
        <p class="text-[var(--color-stone-grey)] dark:text-[var(--color-stone)]">The questions guests ask us most.</p>
      </div>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-xl border border-[var(--color-hairline)] dark:border-[var(--color-stone-grey)] bg-white dark:bg-[var(--color-schist-ink)] p-5">
            <summary class="flex items-center justify-between cursor-pointer font-semibold list-none">
              {faq.data.question}
              <svg class="w-5 h-5 flex-shrink-0 transition-transform group-open:rotate-180 text-[var(--color-stone-grey)]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
            </summary>
            <p class="mt-3 text-sm text-[var(--color-stone-grey)] dark:text-[var(--color-stone)] leading-relaxed">{faq.data.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script>
    function initTestimonials() {
      const root = document.querySelector('[data-testimonials]');
      if (!root) return;
      const items = Array.from(root.querySelectorAll<HTMLElement>('[data-testimonial]'));
      if (items.length < 2) return;
      let i = 0;
      setInterval(() => {
        items[i].classList.add('hidden');
        i = (i + 1) % items.length;
        items[i].classList.remove('hidden');
      }, 6000);
    }
    initTestimonials();
    document.addEventListener('astro:page-load', initTestimonials);

    function initSectionNav() {
      const nav = document.querySelector<HTMLElement>('[data-section-nav]');
      const hero = document.querySelector<HTMLElement>('.hero-section');
      if (!nav || !hero) return;

      const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('[data-section-link]'));
      const sections = links
        .map((link) => {
          const id = link.dataset.sectionLink;
          const el = id ? document.getElementById(id) : null;
          return el ? { id, el, link } : null;
        })
        .filter((s): s is { id: string; el: HTMLElement; link: HTMLAnchorElement } => s !== null);

      // Show/hide the bar once the hero scrolls out of view.
      const heroObserver = new IntersectionObserver(
        ([entry]) => {
          nav.classList.toggle('is-visible', !entry.isIntersecting);
        },
        { rootMargin: '-64px 0px 0px 0px' }
      );
      heroObserver.observe(hero);

      // Highlight whichever tracked section is currently most in view.
      const sectionObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const match = sections.find((s) => s.el === entry.target);
            if (match && entry.isIntersecting) {
              for (const s of sections) s.link.classList.toggle('is-active', s === match);
            }
          }
        },
        { rootMargin: '-96px 0px -70% 0px', threshold: 0 }
      );
      for (const s of sections) sectionObserver.observe(s.el);
    }
    initSectionNav();
    document.addEventListener('astro:page-load', initSectionNav);
  </script>

  <style>
    .section-nav.is-visible {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }
    .section-nav [data-section-link].is-active {
      color: var(--color-ember);
      background-color: color-mix(in srgb, var(--color-ember) 10%, transparent);
    }
  </style>

</BaseLayout>
